# ---------------------------------------------------------------------------
# Shopify Checkout Validator — environment configuration (copy to .env)
# All values are optional; the defaults below match the original main.py.
# ---------------------------------------------------------------------------

# --- server ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
WORKERS=1
# Comma separated list, or * for any origin
CORS_ORIGINS=*

# --- engine ---------------------------------------------------------------
# Path to the cards file (one card per line: cc|mm|yy|cvv)
CARDS_FILE=cards.txt
# Maximum accepted cart total (product + shipping + tax)
MAX_PRICE=500
# Simultaneous requests allowed per store
SITE_CONCURRENCY=15
# curl_cffi connection pool
POOL_SIZE=500
POOL_PER_HOST=25
CONNECT_TIMEOUT=8
REQUEST_TIMEOUT=35
# Product cache TTL in seconds
CACHE_TTL=300

# --- batch job defaults ---------------------------------------------------
DEFAULT_CONCURRENCY=3
DEFAULT_RETRIES=1
MAX_CONCURRENCY=50
MAX_BATCH_TASKS=50000
# A card that errors (captcha, throttle, no product) is rechecked on the next
# store until it earns a real verdict; this caps the stores one card may visit.
CARD_MAX_TARGETS=12
# A store that errors this many times during card checks is dropped from the
# live pool, so no other card is ever sent to it again.
CARD_ERROR_LIMIT=2

# --- storage --------------------------------------------------------------
# HISTORY_FILE=backend/data/history.json
# RUNTIME_SETTINGS_FILE=backend/data/settings.json
HISTORY_LIMIT=5000
# Store full PANs in history? Keep false unless you really need it.
HISTORY_STORE_FULL_CARDS=false

# --- logging --------------------------------------------------------------
# debug | info | warning | error
LOG_LEVEL=info
# LOG_FILE=backend/data/requests.txt
LOG_RING_SIZE=500
